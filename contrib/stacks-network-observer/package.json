{
  "name": "@stacks/network-observer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "astryx": "astryx",
    "build": "tsc -p tsconfig.server.json && vite build",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/server/server/index.js",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "0.3.0",
    "@astryxdesign/theme-neutral": "0.3.0",
    "@stylexjs/stylex": "0.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
