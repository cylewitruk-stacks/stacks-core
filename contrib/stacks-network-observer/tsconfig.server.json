{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist/server",
    "sourceMap": true,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["src/server", "src/shared"]
}
