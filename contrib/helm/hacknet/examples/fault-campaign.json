{
  "apiVersion": "testing.stacks.org/v1alpha1",
  "kind": "FaultCampaign",
  "metadata": {
    "name": "miner-delay-template",
    "namespace": "hacknet-system"
  },
  "spec": {
    "template": true,
    "networkRef": "attacknet",
    "target": {"actors": ["miner-2"]},
    "fault": {
      "type": "network",
      "action": "delay",
      "mode": "all",
      "duration": "45s",
      "parameters": {
        "direction": "both",
        "delay": {"latency": "750ms", "jitter": "200ms", "correlation": "50"}
      }
    },
    "safety": {
      "maxUnavailableSignerPercent": 30,
      "allowQuorumLoss": false,
      "allowBurnchain": false,
      "allowExtendedDuration": false,
      "allowExtremeSeverity": false,
      "allowMinerMajorityOutage": false,
      "allowUnenrolledNetworkTargets": false,
      "maxUnavailableMinerPercent": 50
    },
    "effectAssertions": [{
      "type": "NetworkDegraded",
      "actor": "miner-2",
      "timeoutSeconds": 90
    }],
    "recoveryAssertions": [{
      "type": "NetworkRecovered",
      "actor": "miner-2",
      "timeoutSeconds": 300
    }]
  }
}
