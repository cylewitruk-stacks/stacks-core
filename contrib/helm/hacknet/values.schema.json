{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "watchNamespace": {"type": "string"},
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicaCount", "image"],
      "properties": {
        "replicaCount": {"type": "integer", "const": 1},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
        "logLevel": {"enum": ["DEBUG", "INFO", "ERROR"]},
        "resources": {"type": "object"},
        "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "tolerations": {"type": "array", "items": {"type": "object"}},
        "affinity": {"type": "object"},
        "securityContext": {"type": "object"},
        "podSecurityContext": {"type": "object"}
      }
    },
    "runOperator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicaCount", "image", "ioPressureImage"],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "const": 1},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "imagePullSecrets": {"type": "array", "items": {"type": "object"}},
        "logLevel": {"enum": ["DEBUG", "INFO", "ERROR"]},
        "ioChaosSupportedArchitectures": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": {"enum": ["x64", "arm64", "ppc64", "s390x"]}
        },
        "timeChaosSupportedArchitectures": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": {"enum": ["x64", "arm64", "ppc64", "s390x"]}
        },
        "ioPressureImage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "digest", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "digest": {"type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$"},
            "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "resources": {"type": "object"},
        "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "tolerations": {"type": "array", "items": {"type": "object"}},
        "affinity": {"type": "object"},
        "securityContext": {"type": "object"},
        "podSecurityContext": {"type": "object"}
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations", "tokenExpirationSeconds"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "tokenExpirationSeconds": {"type": "integer", "minimum": 600, "maximum": 86400}
      }
    },
    "runServiceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  },
  "required": ["operator", "runOperator", "serviceAccount", "runServiceAccount", "watchNamespace"]
}
