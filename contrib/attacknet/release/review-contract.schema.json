{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks.org/schemas/attacknet-phase-review-contract-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "phase", "releaseScope", "tier", "requiredReviewers", "requirements", "requiredInventory"],
  "properties": {
    "schemaVersion": {"const": "stacks-attacknet-phase-review-contract/v1"},
    "phase": {"type": "integer", "minimum": 0},
    "releaseScope": {"type": "string", "minLength": 1},
    "tier": {"enum": ["Reduced", "Full"]},
    "requiredReviewers": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["Codex", "Claude Opus 5"]}},
    "requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "requiredInventory": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
