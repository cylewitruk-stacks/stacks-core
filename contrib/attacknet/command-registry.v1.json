{
  "schema": "stacks-attacknet-command-registry/v1",
  "interfaceVersion": "1.0.0",
  "entryPoint": "contrib/attacknet/attacknet",
  "argumentConventions": {
    "options": "Positional arguments precede options. Every positional and option has explicit requiredness and type metadata; valued options use --name=value and boolean switches use --name.",
    "errors": "Usage errors write a concise diagnostic and command usage to stderr and exit 2.",
    "plan": "--plan and --dry-run are aliases. They emit the delegated process and unresolved environment-input source as JSON without reading referenced manifests or executing anything.",
    "stdout": "Machine-readable commands write JSON to stdout where the command contract says so; diagnostics use stderr.",
    "environment": "The facade inherits its process environment for compatibility. Only the command-line inputs recorded here are versioned public inputs; helper-specific environment overrides are advanced and unstable unless a command contract explicitly names them."
  },
  "exitCodes": {
    "0": "Command completed successfully.",
    "1": "The operation or an environmental/verification check failed.",
    "2": "The command or arguments were invalid."
  },
  "commands": [
    {
      "name": "help",
      "purpose": "Show top-level, command-group, or leaf-command help generated from this registry.",
      "stability": "stable",
      "sideEffectClass": "runtime-none",
      "requiredPrivileges": "none",
      "inputs": {
        "positionals": [
          {
            "name": "COMMAND",
            "required": false,
            "variadic": true,
            "maximumItems": 2
          }
        ],
        "options": []
      },
      "outputs": [
        "Human-readable help on stdout."
      ],
      "backendSupport": [
        "offline"
      ],
      "plan": false,
      "examples": [
        "attacknet help",
        "attacknet help lifecycle apply"
      ],
      "implementation": {
        "visibility": "builtin",
        "kind": "help"
      }
    },
