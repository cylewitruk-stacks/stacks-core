  ],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "attacknet-prometheus"},
      "description": "Kubernetes-observed actor identity, placement, lifecycle phase, and admitted image. This metadata is attached by the trusted orchestration plane, not supplied by the actor.",
      "fieldConfig": {"defaults": {"links": []}, "overrides": []},
      "gridPos": {"h": 5, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"cellHeight": "sm", "footer": {"countRows": false, "fields": "", "reducer": ["sum"], "show": false}, "showHeader": true},
      "targets": [{"expr": "attacknet_actor_info{network=\"$network\",actor=\"$actor\"}", "format": "table", "instant": true, "refId": "A"}],
      "title": "Trusted runtime identity (orchestrator observed)",
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "Value": true, "__name__": true, "evidence_source": true, "instance": true, "job": true, "network": true}, "renameByName": {"actor": "Actor", "image_id": "Resolved image", "node": "Kubernetes node", "phase": "Pod phase", "requested_image": "Requested image / version", "role": "Role"}}}],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "attacknet-prometheus"},
      "description": "Whether Prometheus can scrape the actor's own endpoint. Self-reporting can be absent or deceptive in adversarial images; compare with Kubernetes readiness.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [{"options": {"0": {"color": "red", "text": "DOWN"}, "1": {"color": "green", "text": "UP"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 3, "x": 12, "y": 0},
      "id": 2,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "targets": [{"expr": "max(up{attacknet_network=\"$network\",attacknet_actor=\"$actor\"})", "legendFormat": "actor metric endpoint", "refId": "A"}],
      "title": "Self-report endpoint",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "attacknet-prometheus"},
      "description": "Latest Kubernetes readiness recorded by the authenticated event journal.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [{"options": {"0": {"color": "red", "text": "NOT READY"}, "1": {"color": "green", "text": "READY"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 3, "x": 15, "y": 0},
      "id": 3,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "targets": [{"expr": "attacknet_actor_ready{network=\"$network\",actor=\"$actor\"}", "legendFormat": "Kubernetes", "refId": "A"}],
      "title": "Trusted readiness",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "attacknet-prometheus"},
      "description": "Kubernetes-observed container restarts in the latest admitted actor snapshot.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 3}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 3, "x": 18, "y": 0},
      "id": 4,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "targets": [{"expr": "attacknet_actor_restarts{network=\"$network\",actor=\"$actor\"}", "legendFormat": "restarts", "refId": "A"}],
      "title": "Restarts",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "attacknet-prometheus"},
      "description": "Authenticated fault campaigns currently targeting this actor.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 3, "x": 21, "y": 0},
      "id": 5,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "targets": [{"expr": "sum(attacknet_fault_active{network=\"$network\",actor=\"$actor\"}) or vector(0)", "legendFormat": "active", "refId": "A"}],
      "title": "Active faults",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "attacknet-prometheus"},
      "description": "Trusted runtime state, fault injection, and failed invariants aligned in time. This is the first panel to inspect when correlating cause and effect.",
      "fieldConfig": {"defaults": {"custom": {"fillOpacity": 70, "lineWidth": 0, "spanNulls": true}, "mappings": [{"options": {"0": {"color": "green", "text": "clear / pass / ready"}, "1": {"color": "orange", "text": "fault / failure / unready"}}, "type": "value"}], "max": 1, "min": 0}, "overrides": []},
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 5},
      "id": 6,
      "options": {"alignValue": "left", "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "mergeValues": true, "rowHeight": 0.8, "showValue": "auto", "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [
        {"expr": "attacknet_fault_active{network=\"$network\",actor=\"$actor\"}", "legendFormat": "FAULT {{campaign}} / {{fault_type}}", "refId": "A"},
        {"expr": "1 - attacknet_actor_ready{network=\"$network\",actor=\"$actor\"}", "legendFormat": "KUBERNETES unready", "refId": "B"},
        {"expr": "1 - attacknet_invariant_pass{network=\"$network\",actor=\"$actor\"}", "legendFormat": "INVARIANT {{invariant}} failed", "refId": "C"}
      ],
      "title": "Trusted fault and runtime timeline",
      "type": "state-timeline"
    },
    {
      "datasource": {"type": "prometheus", "uid": "attacknet-prometheus"},
      "description": "Node-reported burnchain and Stacks tips for this actor. Empty for signer-only actors. Compare with the network overview before trusting an apparent local lead.",
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "showPoints": "never", "spanNulls": false}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "id": 7,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "stacks_node_burn_block_height{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}", "legendFormat": "burn height", "refId": "A"},
        {"expr": "stacks_node_stacks_tip_height{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}", "legendFormat": "Stacks height", "refId": "B"},
        {"expr": "stacks_signer_stacks_node_height{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}", "legendFormat": "signer's node height", "refId": "C"},
        {"expr": "stacks_signer_state_burn_block_height{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}", "legendFormat": "signer state burn height", "refId": "D"},
        {"expr": "stacks_signer_companion_burn_block_height{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}", "legendFormat": "companion burn height", "refId": "E"}
      ],
      "title": "Self-reported chain progress",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "attacknet-prometheus"},
      "description": "Legacy P2P neighbor counts for node actors. Empty for signer-only actors. A falling count is often the earliest partition signal.",
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 12, "lineWidth": 2, "showPoints": "never", "spanNulls": false}}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 12},
      "id": 8,
      "options": {"legend": {"calcs": ["lastNotNull", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "stacks_node_neighbors_inbound{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}", "legendFormat": "inbound", "refId": "A"},
        {"expr": "stacks_node_neighbors_outbound{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}", "legendFormat": "outbound", "refId": "B"}
      ],
      "title": "Self-reported P2P peers",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "attacknet-prometheus"},
      "description": "Node-reported P2P and RPC byte counters converted to rates. Empty for signer-only actors.",
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never", "spanNulls": false}, "unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 12},
      "id": 9,
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "rate(stacks_node_bandwidth_inbound{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[2m])", "legendFormat": "P2P in", "refId": "A"},
        {"expr": "rate(stacks_node_bandwidth_outbound{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[2m])", "legendFormat": "P2P out", "refId": "B"},
        {"expr": "rate(stacks_node_rpc_bandwidth_inbound{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[2m])", "legendFormat": "RPC in", "refId": "C"},
        {"expr": "rate(stacks_node_rpc_bandwidth_outbound{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[2m])", "legendFormat": "RPC out", "refId": "D"}
      ],
      "title": "Self-reported traffic",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "attacknet-prometheus"},
      "description": "Node block and transaction flow rates. Received, processed, mined, and served rates help locate whether a stall is in production, propagation, or processing.",
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 9, "lineWidth": 2, "showPoints": "never", "spanNulls": false}, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "id": 10,
      "options": {"legend": {"calcs": ["sum", "max"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "rate(stacks_node_btc_blocks_received_total{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[2m])", "legendFormat": "burn blocks processed", "refId": "A"},
        {"expr": "rate(stacks_node_stx_blocks_received_total{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[2m])", "legendFormat": "Stacks blocks received", "refId": "B"},
        {"expr": "rate(stacks_node_stx_blocks_processed_total{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[2m])", "legendFormat": "Stacks blocks processed", "refId": "C"},
        {"expr": "rate(stacks_node_stx_blocks_mined_total{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[2m])", "legendFormat": "Stacks blocks mined", "refId": "D"},
