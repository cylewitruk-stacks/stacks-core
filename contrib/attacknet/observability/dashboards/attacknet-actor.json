    {
      "datasource": {"type": "prometheus", "uid": "attacknet-prometheus"},
      "description": "Signer proposal, validation, precommit, and final response rates. Empty for node-only actors. Divergence between validation and response rates can indicate policy/supersession behavior.",
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "bars", "fillOpacity": 25, "lineWidth": 1, "showPoints": "never", "spanNulls": false}, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 28},
      "id": 12,
      "options": {"legend": {"calcs": ["sum"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "rate(stacks_signer_block_proposals_received{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[2m])", "legendFormat": "proposals", "refId": "A"},
        {"expr": "rate(stacks_signer_block_validation_responses{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[2m])", "legendFormat": "validation {{response_type}}", "refId": "B"},
        {"expr": "rate(stacks_signer_block_pre_commits_sent{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[2m])", "legendFormat": "precommits", "refId": "C"},
        {"expr": "rate(stacks_signer_block_responses_sent{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[2m])", "legendFormat": "legacy response {{response_type}}", "refId": "D"},
        {"expr": "rate(stacks_signer_policy_evaluations{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[2m])", "legendFormat": "policy {{classification}}/{{action}}", "refId": "E"},
        {"expr": "rate(stacks_signer_block_validation_lifecycle{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[2m])", "legendFormat": "lifecycle {{event}}/{{reason}}", "refId": "F"},
        {"expr": "rate(stacks_signer_block_response_deliveries{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[2m])", "legendFormat": "delivery {{response_type}}/{{outcome}}", "refId": "G"}
      ],
      "title": "Signer decision pipeline (self-reported)",
