      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(stacks_signer_block_response_latencies_histogram_bucket{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[5m])))", "legendFormat": "response p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(stacks_signer_block_response_latencies_histogram_bucket{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[5m])))", "legendFormat": "response p95", "refId": "B"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(stacks_signer_block_validation_latencies_histogram_bucket{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[5m])))", "legendFormat": "validation p95", "refId": "C"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(stacks_signer_node_rpc_call_latencies_histogram_bucket{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[5m])))", "legendFormat": "node RPC p95", "refId": "D"}
      ],
      "title": "Signer latency (self-reported)",
