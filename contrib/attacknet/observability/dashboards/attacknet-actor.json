        {"expr": "rate(stacks_node_transactions_received_total{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[2m])", "legendFormat": "transactions received", "refId": "F"}
      ],
      "title": "Self-reported block pipeline",
