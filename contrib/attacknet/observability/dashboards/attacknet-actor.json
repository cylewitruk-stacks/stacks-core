    {
      "datasource": {"type": "prometheus", "uid": "attacknet-prometheus"},
      "description": "Signer lifecycle flags and reward cycle. Empty for node-only actors. Registered-current=0 means the signer cannot contribute weight now.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [{"options": {"0": {"color": "red", "text": "NO"}, "1": {"color": "green", "text": "YES"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": [{"matcher": {"id": "byRegexp", "options": "/reward cycle|pending validations/"}, "properties": [{"id": "mappings", "value": []}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}]}]},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "id": 11,
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name", "wideLayout": true},
      "targets": [
        {"expr": "stacks_signer_runloop_ready{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}", "legendFormat": "runloop ready", "refId": "A"},
        {"expr": "stacks_signer_registered_for_current_reward_cycle{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}", "legendFormat": "registered current", "refId": "B"},
        {"expr": "stacks_signer_registered_for_next_reward_cycle{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}", "legendFormat": "registered next", "refId": "C"},
        {"expr": "stacks_signer_current_reward_cycle{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}", "legendFormat": "reward cycle", "refId": "D"},
        {"expr": "stacks_signer_pending_block_validations{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}", "legendFormat": "pending validations", "refId": "E"}
      ],
      "title": "Signer participation state (self-reported)",
