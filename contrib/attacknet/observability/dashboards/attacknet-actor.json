        {"expr": "stacks_node_last_block_write_count{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}", "legendFormat": "write count", "refId": "C"},
        {"expr": "stacks_node_last_block_transaction_count{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}", "legendFormat": "transactions", "refId": "D"},
