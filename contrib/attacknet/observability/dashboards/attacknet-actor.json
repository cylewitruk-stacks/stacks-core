    {
      "datasource": {"type": "prometheus", "uid": "attacknet-prometheus"},
      "description": "Node warning/error rates, unreachable VM errors, and miner stop reasons. These actor-self-reported signals guide log inspection but are not authoritative under a malicious image.",
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "bars", "fillOpacity": 25, "lineWidth": 1, "showPoints": "never", "spanNulls": false}, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 37},
      "id": 14,
      "options": {"legend": {"calcs": ["sum"], "displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "rate(stacks_node_warning_emitted_total{attacknet_network=\"$network\",attacknet_actor=\"$actor\"}[2m])", "legendFormat": "warnings", "refId": "A"},
