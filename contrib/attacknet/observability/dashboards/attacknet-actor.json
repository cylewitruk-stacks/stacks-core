    {
      "datasource": {"type": "prometheus", "uid": "attacknet-prometheus"},
      "description": "Signer p50/p95 response and validation latency plus node-RPC p95. Histograms are in seconds. Empty when the selected image does not expose a family.",
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 8, "lineWidth": 2, "showPoints": "never", "spanNulls": false}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 28},
