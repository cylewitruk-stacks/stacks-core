{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks.org/schemas/attacknet-version-matrix-v1.json",
  "title": "Stacks attacknet version matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "matrixId", "targetPlatform", "bounds", "actors", "defaultProfile", "profiles", "phases"],
  "properties": {
    "schemaVersion": {"const": 1},
    "matrixId": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,62}[a-z0-9])?$"},
    "targetPlatform": {"enum": ["linux/amd64", "linux/arm64"]},
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxProfiles", "maxActors", "maxPhases"],
      "properties": {
        "maxProfiles": {"type": "integer", "minimum": 1, "maximum": 32},
        "maxActors": {"type": "integer", "minimum": 1, "maximum": 128},
        "maxPhases": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"}
    },
    "defaultProfile": {"type": "string"},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/profile"}
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/phase"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository"],
          "properties": {
            "kind": {"const": "current"},
            "repository": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "gitRef"],
          "properties": {
            "kind": {"const": "releasedGitRef"},
            "repository": {"type": "string", "minLength": 1},
            "gitRef": {"type": "string", "minLength": 1},
            "expectedRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "changeId"],
          "properties": {
            "kind": {"const": "localModified"},
            "repository": {"type": "string", "minLength": 1},
            "baseRef": {"type": "string", "minLength": 1},
            "changeId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"}
          }
        }
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedRef", "origin", "platforms"],
      "properties": {
        "requestedRef": {"type": "string", "minLength": 1},
        "origin": {"enum": ["prebuilt", "localBuild"]},
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["linux/amd64", "linux/arm64"]}
        },
        "execution": {"enum": ["native", "emulated"]},
        "executionPlatform": {"enum": ["linux/amd64", "linux/arm64"]},
        "attestationRef": {"type": "string", "minLength": 1},
        "attestationDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dockerfile", "cargoProfile", "cargoChef", "cargoIncremental", "builderImage", "runtimeImage"],
      "properties": {
        "dockerfile": {"type": "string", "minLength": 1},
        "cargoProfile": {"type": "string", "minLength": 1},
        "cargoChef": {"const": true},
        "cargoIncremental": {"const": false},
        "cargoFeatures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"}
        },
        "builderImage": {"type": "string", "minLength": 1},
        "runtimeImage": {"type": "string", "minLength": 1},
        "recipeDigest": {"$ref": "#/$defs/sha256"},
        "buildInvocationDigest": {"$ref": "#/$defs/sha256"},
        "attestationRef": {"type": "string", "minLength": 1},
        "attestationDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectation", "basis"],
      "properties": {
        "expectation": {"enum": ["compatible", "intentionally-incompatible", "unknown"]},
        "basis": {"type": "string", "minLength": 1},
        "protocolVersions": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "epochs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "image", "compatibility"],
      "properties": {
        "source": {"$ref": "#/$defs/source"},
        "image": {"$ref": "#/$defs/image"},
        "build": {"$ref": "#/$defs/build"},
        "compatibility": {"$ref": "#/$defs/compatibility"}
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "actors"],
      "properties": {
        "profile": {"type": "string"},
        "actors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "assignments", "expectedOutcome"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,62}[a-z0-9])?$"},
        "kind": {"enum": ["baseline", "rolling-upgrade", "missed-upgrade", "modified-actor"]},
        "inherits": {"type": "string"},
        "assignments": {"type": "array", "items": {"$ref": "#/$defs/assignment"}},
        "expectedOutcome": {"enum": ["compatible", "intentional-failure", "observe"]},
        "hypothesis": {"type": "string", "minLength": 1}
      }
    }
  }
}
