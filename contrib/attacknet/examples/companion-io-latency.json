{
  "apiVersion": "testing.stacks.org/v1alpha1",
  "kind": "FaultCampaign",
  "metadata": {"name": "companion-1-io-latency"},
  "spec": {
    "networkRef": "attacknet",
    "target": {"actors": ["signer-node-1"]},
    "fault": {
      "type": "io",
      "action": "latency",
      "mode": "all",
      "duration": "30s",
      "parameters": {"volumePath": "/data", "path": "/data/**", "delay": "150ms", "percent": 50}
    },
    "safety": {"maxUnavailableSignerPercent": 30}
  }
}
