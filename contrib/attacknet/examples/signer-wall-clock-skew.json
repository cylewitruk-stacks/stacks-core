{
  "apiVersion": "testing.stacks.org/v1alpha1",
  "kind": "FaultCampaign",
  "metadata": {"name": "signer-1-wall-clock-skew"},
  "spec": {
    "networkRef": "attacknet",
    "target": {"actors": ["signer-1"]},
    "fault": {
      "type": "time",
      "mode": "all",
      "duration": "30s",
      "parameters": {"timeOffset": "-30s", "clockIds": ["CLOCK_REALTIME"]}
    },
    "safety": {"maxUnavailableSignerPercent": 30}
  }
}
