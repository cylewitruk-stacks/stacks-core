{
  "apiVersion": "testing.stacks.org/v1alpha1",
  "kind": "FaultCampaign",
  "metadata": {
    "name": "ddmin-live-network-negative-template",
    "namespace": "hacknet-system"
  },
  "spec": {
    "template": true,
    "networkRef": "attacknet-ddmin-live",
    "target": {"actors": ["follower-1"]},
    "fault": {
      "type": "network",
      "action": "duplicate",
      "mode": "all",
      "duration": "15s",
      "parameters": {
        "direction": "both",
        "peerTarget": {"actors": ["miner-1"], "mode": "all"},
        "duplicate": {"duplicate": "10", "correlation": "0"}
      }
    },
    "safety": {
      "maxUnavailableSignerPercent": 30,
      "allowQuorumLoss": false,
      "allowBurnchain": false,
      "allowExtendedDuration": false,
      "allowExtremeSeverity": false,
      "allowMinerMajorityOutage": false,
      "allowUnenrolledNetworkTargets": false,
      "maxUnavailableMinerPercent": 50
    },
    "effectAssertions": [{
      "type": "NetworkDegraded",
      "actor": "follower-1",
      "timeoutSeconds": 90
    }],
    "recoveryAssertions": [{
      "type": "NetworkRecovered",
      "actor": "follower-1",
      "timeoutSeconds": 300
    }]
  }
}
