{
  "apiVersion": "testing.stacks.org/v1alpha1",
  "kind": "AttacknetRun",
  "metadata": {
    "name": "ddmin-live-source",
    "namespace": "hacknet-system"
  },
  "spec": {
    "networkRef": "attacknet-ddmin-live",
    "seed": "ddmin-live-negative-control-v1",
    "decisionAlgorithm": "hmac-sha256-decisions/v1",
    "campaignCatalog": [
      {"name": "pod-kill", "campaignRef": "ddmin-live-pod-template"},
      {"name": "tcp-duplicate-negative", "campaignRef": "ddmin-live-network-negative-template"}
    ],
    "sequence": [
      {"id": "irrelevant-pod-kill", "campaign": "pod-kill", "delayAfterSeconds": 0, "enabled": true},
      {"id": "tcp-duplicate-negative", "campaign": "tcp-duplicate-negative", "delayAfterSeconds": 0, "enabled": true}
    ],
    "budgets": {
      "maxCampaigns": 2,
      "maxWallTimeSeconds": 1200,
      "maxCumulativeFaultSeconds": 30,
      "maxActiveFaults": 1,
      "maxSignerImpactPercent": 30,
      "maxBurnchainFaults": 0,
      "maxInconclusiveCampaigns": 0
    },
    "stopPolicy": {
      "onCampaignFailure": "Stop",
      "onInconclusive": "Stop",
      "onBudgetExhausted": "Stop",
      "onSuccess": "Continue"
    },
    "attributionPolicy": {
      "requiredOnFailure": true,
      "requireIncidentBundle": true,
      "allowedTerminalStates": ["Triaged", "Remediated", "Inconclusive"]
    },
    "replay": {
      "enabled": false,
      "requireSameResolvedImages": true,
      "verifyExpectedFailure": true
    },
    "resume": {
      "enabled": false,
      "requireSameSeed": true,
      "requireSameResolvedImages": true
    },
    "minimization": {
      "enabled": false,
      "strategy": "FailurePrefix",
      "maxAttempts": 0,
      "requireFreshNetwork": true
    }
  }
}
