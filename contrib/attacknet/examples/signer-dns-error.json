{
  "apiVersion": "testing.stacks.org/v1alpha1",
  "kind": "FaultCampaign",
  "metadata": {"name": "signer-1-dns-error"},
  "spec": {
    "networkRef": "attacknet",
    "target": {"actors": ["signer-1"]},
    "fault": {
      "type": "dns",
      "action": "error",
      "mode": "all",
      "duration": "30s",
      "parameters": {"patterns": ["attacknet-signer-node-1.hacknet-system.svc.cluster.local"]}
    },
    "safety": {"maxUnavailableSignerPercent": 30}
  }
}
