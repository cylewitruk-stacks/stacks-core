+#[cfg(feature = "testing")]
+fn validate_attacknet_policy(policy: &AttacknetPolicy) -> Result<(), &'static str> {
+    if policy.profile != ATTACKNET_POLICY_PROFILE {
+        return Err("unsupported profile");
+    }
+    if policy.algorithm != ATTACKNET_POLICY_ALGORITHM {
+        return Err("unsupported selector algorithm");
+    }
+    if !(1..=1024).contains(&policy.max_matches) {
+        return Err("maxMatches is out of bounds");
+    }
+    if policy.max_evaluations < policy.max_matches || policy.max_evaluations > 65_536 {
+        return Err("maxEvaluations is out of bounds");
+    }
+    let Some(patch_digest) = policy.patch_digest.strip_prefix("sha256:") else {
+        return Err("patchDigest is malformed");
+    };
+    if patch_digest.len() != 64
+        || !patch_digest
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+    {
+        return Err("patchDigest is malformed");
+    }
+    if !matches!(
+        policy.behavior.as_str(),
+        "withhold" | "delay" | "suppress-peer-responses"
+    ) {
+        return Err("unsupported behavior");
+    }
+    let selector = &policy.selector;
+    if selector.every_nth > 1024 {
+        return Err("everyNth is out of bounds");
+    }
+    if selector.every_nth == 0 && selector.seed_offset != 0 {
+        return Err("seedOffset requires everyNth");
+    }
+    if selector.every_nth > 0 && selector.seed_offset >= selector.every_nth {
+        return Err("seedOffset must be less than everyNth");
+    }
+    if selector.min_stacks_height == Some(0)
+        || selector.max_stacks_height == Some(0)
+        || selector
+            .min_stacks_height
+            .zip(selector.max_stacks_height)
+            .is_some_and(|(minimum, maximum)| minimum > maximum)
+    {
+        return Err("Stacks height window is invalid");
+    }
+    if !selector.proposal_hash_prefix.is_empty()
+        && (!(2..=32).contains(&selector.proposal_hash_prefix.len())
+            || !selector
+                .proposal_hash_prefix
+                .bytes()
+                .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte)))
+    {
+        return Err("proposalHashPrefix is malformed");
+    }
+    if policy.behavior == "delay" {
+        if !(1..=120_000).contains(&policy.delay_millis) {
+            return Err("delay is out of bounds");
+        }
+    } else if policy.delay_millis != 0 {
+        return Err("delay is valid only for delay behavior");
+    }
+    if policy.behavior == "suppress-peer-responses"
+        && (selector.min_stacks_height.is_some()
+            || selector.max_stacks_height.is_some()
+            || selector.every_nth != 0)
+    {
+        return Err("peer suppression supports only hash-prefix selection");
+    }
+    Ok(())
+}
