+
+#[cfg(all(test, feature = "testing"))]
+mod attacknet_policy_tests {
+    use std::time::Duration;
+
+    use super::{
+        attacknet_policy_match_with, attacknet_response_delay_with,
+        attacknet_session_value_is_active, peer_response_is_suppressed, proposal_is_withheld,
+        validate_attacknet_policy, validate_attacknet_session, AttacknetPolicy,
+        AttacknetPolicyState,
+    };
+
+    fn policy() -> AttacknetPolicy {
+        serde_json::from_str(
+            r#"{
+            "algorithm":"stacks-signer-adversarial-selector/v1",
+            "behavior":"withhold",
+            "maxEvaluations":8,
+            "maxMatches":2,
+            "patchDigest":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+            "profile":"stacks-signer-testing/v1",
+            "selector":{"everyNth":2,"minStacksHeight":10,"proposalHashPrefix":"ab","seedOffset":0}
+        }"#,
+        )
+        .unwrap()
+    }
+
+    #[test]
+    fn selector_is_deterministic_and_bounded() {
+        let policy = policy();
+        let mut state = AttacknetPolicyState::default();
+        assert!(attacknet_policy_match_with(
+            &policy,
+            &mut state,
+            "ab00",
+            Some(10)
+        ));
+        assert!(attacknet_policy_match_with(
+            &policy,
+            &mut state,
+            "ab00",
+            Some(10)
+        ));
+        assert!(!attacknet_policy_match_with(
+            &policy,
+            &mut state,
+            "ab01",
+            Some(10)
+        ));
+        assert!(attacknet_policy_match_with(
+            &policy,
+            &mut state,
+            "ab02",
+            Some(11)
+        ));
+        assert!(!attacknet_policy_match_with(
+            &policy,
+            &mut state,
+            "ab04",
+            Some(12)
+        ));
+        assert!(!attacknet_policy_match_with(
+            &policy,
+            &mut state,
+            "ff06",
+            Some(12)
+        ));
+        assert!(!attacknet_policy_match_with(
+            &policy,
+            &mut state,
+            "ab08",
+            Some(9)
+        ));
+    }
+
+    #[test]
+    fn policy_rejects_unknown_fields() {
+        let source = r#"{
+            "algorithm":"stacks-signer-adversarial-selector/v1",
+            "behavior":"withhold",
+            "maxEvaluations":8,
+            "maxMatches":1,
+            "patchDigest":"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+            "profile":"stacks-signer-testing/v1",
+            "selector":{},
+            "command":"arbitrary"
+        }"#;
+        assert!(serde_json::from_str::<AttacknetPolicy>(source).is_err());
+    }
+
+    #[test]
+    fn policy_contract_rejects_malformed_bounded_fields() {
+        let mut value = policy();
+        assert!(validate_attacknet_policy(&value).is_ok());
+        value.patch_digest = "sha256:UPPER".into();
+        assert!(validate_attacknet_policy(&value).is_err());
+        value = policy();
+        value.selector.proposal_hash_prefix = "a".into();
+        assert!(validate_attacknet_policy(&value).is_err());
+        value = policy();
+        value.selector.max_stacks_height = Some(9);
+        assert!(validate_attacknet_policy(&value).is_err());
+        value = policy();
+        value.max_evaluations = 1;
+        assert!(validate_attacknet_policy(&value).is_err());
+    }
+
+    #[test]
+    fn behaviors_are_disjoint_and_delay_only_the_first_response() {
+        let mut value = policy();
+        assert!(proposal_is_withheld(&value, true));
+        assert!(!peer_response_is_suppressed(&value, true));
+
+        value.behavior = "delay".into();
+        value.delay_millis = 25;
+        let mut state = AttacknetPolicyState::default();
+        state.decisions.insert("ab00".into(), true);
+        assert_eq!(
+            attacknet_response_delay_with(&value, &mut state, "ab00"),
+            Some(Duration::from_millis(25))
+        );
+        assert_eq!(
+            attacknet_response_delay_with(&value, &mut state, "ab00"),
+            None
+        );
+        assert!(!proposal_is_withheld(&value, true));
+
+        value.behavior = "suppress-peer-responses".into();
+        value.delay_millis = 0;
+        assert!(peer_response_is_suppressed(&value, true));
+        assert!(!proposal_is_withheld(&value, true));
+    }
+
+    #[test]
+    fn session_must_bind_actor_action_policy_and_campaign() {
+        let mut value = policy();
+        value.managed_digest =
+            "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb".into();
+        let valid = r#"{"action":"withhold","actor":"signer-1","campaignUid":"campaign-uid","policyDigest":"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb","schemaVersion":"stacks-attacknet-signer-behavior-session/v1"}"#;
+        assert!(validate_attacknet_session(&value, "signer-1", valid));
+        assert!(!validate_attacknet_session(&value, "signer-2", valid));
+        assert!(!validate_attacknet_session(
+            &value,
+            "signer-1",
+            &valid.replace("withhold", "delay")
+        ));
+        assert!(!validate_attacknet_session(
+            &value,
+            "signer-1",
+            &valid.replace("campaign-uid", "")
+        ));
+        assert!(!validate_attacknet_session(
+            &value,
+            "signer-1",
+            &valid.replace('b', "c")
+        ));
+        assert!(attacknet_session_value_is_active(
+            &value,
+            Some(valid),
+            Some("signer-1")
+        ));
+        assert!(!attacknet_session_value_is_active(
+            &value,
+            None,
+            Some("signer-1")
+        ));
+    }
+}
