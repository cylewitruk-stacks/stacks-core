+#[cfg(feature = "testing")]
+fn apply_attacknet_proposal_policy(block_proposal: &BlockProposal) -> bool {
+    let Some(policy) = ATTACKNET_POLICY.as_ref() else {
+        return false;
+    };
+    if policy.behavior == "suppress-peer-responses" {
+        return false;
+    }
+    if !attacknet_session_is_active(policy) {
+        return false;
+    }
+    let hash = block_proposal
+        .block
+        .header
+        .signer_signature_hash()
+        .to_string();
+    if !attacknet_policy_match(&hash, Some(block_proposal.block.header.chain_length)) {
+        return false;
+    }
+    warn!("ATTACKNET TEST POLICY MATCHED BLOCK PROPOSAL";
+        "behavior" => policy.behavior.as_str(),
+        "signer_signature_hash" => hash,
+        "block_height" => block_proposal.block.header.chain_length,
+    );
+    proposal_is_withheld(policy, true)
+}
+
+#[cfg(feature = "testing")]
+fn proposal_is_withheld(policy: &AttacknetPolicy, selected: bool) -> bool {
+    selected && policy.behavior == "withhold"
+}
+
+#[cfg(feature = "testing")]
+fn attacknet_response_delay(block_response: &BlockResponse) -> Option<Duration> {
+    let policy = ATTACKNET_POLICY.as_ref()?;
+    if policy.behavior != "delay" || !attacknet_session_is_active(policy) {
+        return None;
+    }
+    let hash = block_response.get_signer_signature_hash().to_string();
+    let mut state = ATTACKNET_POLICY_STATE
+        .lock()
+        .expect("Attacknet policy state lock poisoned");
+    let delay = attacknet_response_delay_with(policy, &mut state, &hash)?;
+    warn!("ATTACKNET TEST POLICY DELAYING FIRST BLOCK RESPONSE";
+        "behavior" => policy.behavior.as_str(),
+        "signer_signature_hash" => hash,
+        "delay_millis" => policy.delay_millis,
+    );
+    Some(delay)
+}
+
+#[cfg(feature = "testing")]
+fn attacknet_response_delay_with(
+    policy: &AttacknetPolicy,
+    state: &mut AttacknetPolicyState,
+    hash: &str,
+) -> Option<Duration> {
+    if policy.behavior != "delay"
+        || state.decisions.get(hash) != Some(&true)
+        || !state.delayed_responses.insert(hash.to_owned())
+    {
+        return None;
+    }
+    Some(Duration::from_millis(policy.delay_millis))
+}
+
+#[cfg(feature = "testing")]
+fn apply_attacknet_peer_response_policy(block_response: &BlockResponse) -> bool {
+    let Some(policy) = ATTACKNET_POLICY.as_ref() else {
+        return false;
+    };
+    if policy.behavior != "suppress-peer-responses" || !attacknet_session_is_active(policy) {
+        return false;
+    }
+    let hash = block_response.get_signer_signature_hash().to_string();
+    let selected = attacknet_policy_match(&hash, None);
+    if selected {
+        warn!("ATTACKNET TEST POLICY SUPPRESSED PEER RESPONSE";
+            "behavior" => policy.behavior.as_str(),
+            "signer_signature_hash" => hash,
+        );
+    }
+    peer_response_is_suppressed(policy, selected)
+}
+
+#[cfg(feature = "testing")]
+fn peer_response_is_suppressed(policy: &AttacknetPolicy, selected: bool) -> bool {
+    selected && policy.behavior == "suppress-peer-responses"
+}
