+#[cfg(feature = "testing")]
+static ATTACKNET_POLICY: LazyLock<Option<AttacknetPolicy>> = LazyLock::new(|| {
+    let Ok(raw) = std::env::var("STACKS_SIGNER_ATTACKNET_POLICY") else {
+        return None;
+    };
+    let declared_digest = std::env::var("STACKS_SIGNER_ATTACKNET_POLICY_DIGEST")
+        .expect("STACKS_SIGNER_ATTACKNET_POLICY requires its managed digest");
+    let actual_digest = format!("sha256:{}", Sha256Sum::from_data(raw.as_bytes()));
+    assert_eq!(
+        declared_digest, actual_digest,
+        "STACKS_SIGNER_ATTACKNET_POLICY digest mismatch"
+    );
+    let mut policy: AttacknetPolicy =
+        serde_json::from_str(&raw).expect("invalid STACKS_SIGNER_ATTACKNET_POLICY JSON");
+    policy.managed_digest = declared_digest;
+    validate_attacknet_policy(&policy).expect("invalid STACKS_SIGNER_ATTACKNET_POLICY contract");
+    Some(policy)
+});
