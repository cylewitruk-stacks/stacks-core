+#[cfg(feature = "testing")]
+fn attacknet_policy_match(hash: &str, height: Option<u64>) -> bool {
+    let Some(policy) = ATTACKNET_POLICY.as_ref() else {
+        return false;
+    };
+    let mut state = ATTACKNET_POLICY_STATE
+        .lock()
+        .expect("Attacknet policy state lock poisoned");
+    attacknet_policy_match_with(policy, &mut state, hash, height)
+}
+
+#[cfg(feature = "testing")]
+fn attacknet_policy_match_with(
+    policy: &AttacknetPolicy,
+    state: &mut AttacknetPolicyState,
+    hash: &str,
+    height: Option<u64>,
+) -> bool {
+    if let Some(selected) = state.decisions.get(hash) {
+        return *selected;
+    }
+    if state.evaluated >= policy.max_evaluations || state.matched >= policy.max_matches {
+        return false;
+    }
+    state.evaluated += 1;
+    crate::monitoring::actions::set_attacknet_policy_evaluations(&policy.behavior, state.evaluated);
+    if state.seen.insert(hash.to_owned()) {
+        state.ordinal = state.ordinal.saturating_add(1);
+    }
+    let selector = &policy.selector;
+    let in_height_window = match height {
+        Some(value) => {
+            selector
+                .min_stacks_height
+                .is_none_or(|minimum| value >= minimum)
+                && selector
+                    .max_stacks_height
+                    .is_none_or(|maximum| value <= maximum)
+        }
+        None => selector.min_stacks_height.is_none() && selector.max_stacks_height.is_none(),
+    };
+    let prefix_matches = selector.proposal_hash_prefix.is_empty()
+        || hash.starts_with(&selector.proposal_hash_prefix);
+    let ordinal_matches = selector.every_nth == 0
+        || (state.ordinal + u64::from(selector.seed_offset) - 1) % u64::from(selector.every_nth)
+            == 0;
+    let selected =
+        in_height_window && prefix_matches && ordinal_matches && state.matched < policy.max_matches;
+    if selected {
+        state.matched += 1;
+        crate::monitoring::actions::increment_attacknet_policy_match(&policy.behavior);
+    }
+    state.decisions.insert(hash.to_owned(), selected);
+    selected
+}
