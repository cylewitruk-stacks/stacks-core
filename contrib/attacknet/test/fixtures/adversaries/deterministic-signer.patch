+#[cfg(feature = "testing")]
+fn validate_attacknet_session(policy: &AttacknetPolicy, actor: &str, raw: &str) -> bool {
+    if raw.len() > 1024 || actor.is_empty() {
+        return false;
+    }
+    let Ok(session) = serde_json::from_str::<AttacknetSession>(raw) else {
+        return false;
+    };
+    session.schema_version == "stacks-attacknet-signer-behavior-session/v1"
+        && session.action == policy.behavior
+        && session.actor == actor
+        && !session.campaign_uid.is_empty()
+        && session.policy_digest == policy.managed_digest
+}
+
+#[cfg(feature = "testing")]
+/// Validate one possibly absent projected session value.
+fn attacknet_session_value_is_active(
+    policy: &AttacknetPolicy,
+    raw: Option<&str>,
+    actor: Option<&str>,
+) -> bool {
+    raw.zip(actor)
+        .is_some_and(|(raw, actor)| validate_attacknet_session(policy, actor, raw.trim()))
+}
+
+#[cfg(feature = "testing")]
+/// Read the projected session contract and publish its current active state.
+fn read_attacknet_session(policy: &AttacknetPolicy) -> bool {
+    let raw = std::env::var("STACKS_SIGNER_ATTACKNET_SESSION")
+        .ok()
+        .and_then(|path| fs::read_to_string(path).ok());
+    let actor = std::env::var("HACKNET_ACTOR").ok();
+    let active = attacknet_session_value_is_active(policy, raw.as_deref(), actor.as_deref());
+    crate::monitoring::actions::set_attacknet_policy_session_active(&policy.behavior, active);
+    active
+}
+
+#[cfg(feature = "testing")]
+/// Check the session at a protocol decision point.
+fn attacknet_session_is_active(policy: &AttacknetPolicy) -> bool {
+    read_attacknet_session(policy)
+}
+
+#[cfg(feature = "testing")]
+/// Refresh session evidence even when the fault suppresses protocol traffic.
+fn start_attacknet_session_monitor(policy: &'static AttacknetPolicy) {
+    std::thread::Builder::new()
+        .name("attacknet-session-monitor".into())
+        .spawn(move || loop {
+            read_attacknet_session(policy);
+            std::thread::sleep(Duration::from_millis(500));
+        })
+        .expect("failed to start Attacknet session monitor");
+}
