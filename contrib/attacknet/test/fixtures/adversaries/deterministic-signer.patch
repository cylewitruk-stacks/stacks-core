+#[cfg(feature = "testing")]
+/// Initialize bounded policy metrics and the independent session monitor.
+pub(crate) fn initialize_attacknet_policy_observation() {
+    ATTACKNET_POLICY_OBSERVATION_STARTED.get_or_init(|| {
+        if let Some(policy) = ATTACKNET_POLICY.as_ref() {
+            crate::monitoring::actions::set_attacknet_policy_evaluations(&policy.behavior, 0);
+            crate::monitoring::actions::set_attacknet_policy_session_active(
+                &policy.behavior,
+                false,
+            );
+            start_attacknet_session_monitor(policy);
+        }
+    });
+}
