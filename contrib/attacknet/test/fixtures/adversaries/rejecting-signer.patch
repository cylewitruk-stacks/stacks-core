+#[cfg(feature = "testing")]
+fn configure_attacknet_test_directive(private_key: &StacksPrivateKey) {
+    let Ok(directive) = std::env::var("STACKS_SIGNER_TEST_DIRECTIVE") else {
+        return;
+    };
+    let public_key = StacksPublicKey::from_private(private_key);
+    match directive.as_str() {
+        "reject-all" => {
+            crate::v0::tests::TEST_REJECT_ALL_BLOCK_PROPOSAL.set(vec![public_key]);
+            warn!(
+                "ATTACKNET TEST DIRECTIVE ACTIVE: signer will reject every block proposal";
+                "directive" => directive
+            );
+        }
+        "ignore-all" => {
+            crate::v0::tests::TEST_IGNORE_ALL_BLOCK_PROPOSALS.set(vec![public_key]);
+            warn!(
+                "ATTACKNET TEST DIRECTIVE ACTIVE: signer will ignore every block proposal";
+                "directive" => directive
+            );
+        }
+        _ => panic!(
+            "unsupported STACKS_SIGNER_TEST_DIRECTIVE={directive:?}; expected reject-all or ignore-all"
+        ),
+    }
+}
