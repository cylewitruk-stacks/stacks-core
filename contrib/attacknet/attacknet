#!/usr/bin/env node
'use strict';

const {readFileSync, realpathSync} = require('node:fs');
const {dirname, join, resolve} = require('node:path');
const {spawnSync} = require('node:child_process');

const ATTACKNET_DIR = dirname(realpathSync(process.argv[1]));
const REGISTRY_PATH = join(ATTACKNET_DIR, 'command-registry.v1.json');
const {loadRegistry} = require(join(ATTACKNET_DIR, 'command-contract.cjs'));

function die(message, help) {
  process.stderr.write(`attacknet: ${message}\n`);
  if (help) process.stderr.write(`${help}\n`);
  process.exitCode = 2;
}

function registry() {
  return loadRegistry(REGISTRY_PATH, ATTACKNET_DIR);
}

function positionalUsage(positional) {
  const name = positional.variadic ? `${positional.name}...` : positional.name;
  return positional.required ? name : `[${name}]`;
}

function optionUsage(option) {
  const value = option.type === 'boolean' ? option.name
    : `${option.name}=${option.type === 'enum' ? option.enum.join('|') : option.type.toUpperCase()}`;
  return option.required ? value : `[${value}]`;
}

function usageFor(command) {
  const options = command.inputs.options.map(optionUsage).join(' ');
  const positionals = command.inputs.positionals.map(positionalUsage).join(' ');
  const plan = command.plan ? ' [--plan]' : '';
  return `usage: attacknet ${command.name}${positionals ? ` ${positionals}` : ''}${options ? ` ${options}` : ''}${plan}`;
}

function commandHelp(command, value) {
  return [
    usageFor(command),
    '',
    command.purpose,
    '',
    `Stability: ${command.stability}`,
    `Side effects: ${command.sideEffectClass}`,
    `Privileges: ${command.requiredPrivileges}`,
    `Backends: ${command.backendSupport.join(', ')}`,
    `Plan mode: ${command.plan ? 'supported via --plan or --dry-run' : 'not applicable (the command is already read-only/planning)'}`,
    '',
    'Outputs:',
    ...command.outputs.map(output => `  - ${output}`),
    '',
    'Exit codes:',
    ...Object.entries(value.exitCodes).map(([code, description]) => `  ${code}  ${description}`),
    '',
    'Examples:',
    ...command.examples.map(example => `  ${example}`),
  ].join('\n');
}

function groupHelp(value, group) {
  const commands = value.commands.filter(command => command.name === group || command.name.startsWith(`${group} `));
  if (commands.length === 0) return null;
  return [
    `usage: attacknet ${group}${commands.some(command => command.name !== group) ? ' COMMAND' : ''} [ARGS]`,
    '',
    ...commands.map(command => `  ${command.name.padEnd(24)} ${command.purpose}`),
    '',
    `Run 'attacknet help ${group} COMMAND' for a leaf contract.`,
  ].join('\n');
}

function topHelp(value) {
  const top = [];
  const seen = new Set();
  for (const command of value.commands) {
    const group = command.name.split(' ')[0];
    if (seen.has(group)) continue;
    seen.add(group);
    top.push({group, purpose: command.name === group
      ? command.purpose
      : `Commands for ${group} workflows.`});
  }
  return [
    'usage: attacknet COMMAND [ARGS]',
    '',
    `Stacks Attacknet command interface ${value.interfaceVersion}`,
    '',
    ...top.map(item => `  ${item.group.padEnd(14)} ${item.purpose}`),
    '',
    "Run 'attacknet help COMMAND' for human help.",
    "Run 'attacknet commands --json' for the complete agent contract.",
  ].join('\n');
}

function findCommand(value, argv) {
  const candidates = value.commands
    .map(command => ({command, words: command.name.split(' ')}))
    .filter(candidate => candidate.words.every((word, index) => argv[index] === word))
    .sort((left, right) => right.words.length - left.words.length);
  return candidates[0] ?? null;
}

function optionName(value) {
  return value.includes('=') ? value.slice(0, value.indexOf('=')) : value;
}

function validateArguments(command, args) {
  const allowed = new Map(command.inputs.options.map(option => [option.name, option]));
  if (command.plan) {
    allowed.set('--plan', {name: '--plan', type: 'boolean', required: false});
    allowed.set('--dry-run', {name: '--dry-run', type: 'boolean', required: false});
  }
  const seenOptions = new Set();
  for (const argument of args.filter(item => item.startsWith('-'))) {
    const name = optionName(argument);
    const contract = allowed.get(name);
    if (!contract) return `unknown option ${name}`;
    if (seenOptions.has(name)) return `${name} may be supplied only once`;
    seenOptions.add(name);
    const hasValue = argument.includes('=');
    if (contract.type !== 'boolean' && !hasValue) return `${name} requires --name=value syntax`;
    if (contract.type === 'boolean' && hasValue) return `${name} is a boolean switch`;
    const value = hasValue ? argument.slice(argument.indexOf('=') + 1) : null;
    if (hasValue && !value) return `${name} requires a non-empty value`;
    if (contract.type === 'integer'
        && (!/^\d+$/.test(value) || !Number.isSafeInteger(Number(value)) || Number(value) < contract.minimum)) {
      return `${name} must be an integer greater than or equal to ${contract.minimum}`;
    }
    if (contract.type === 'enum' && !contract.enum.includes(value)) {
      return `${name} must be one of: ${contract.enum.join(', ')}`;
    }
  }
  if (seenOptions.has('--plan') && seenOptions.has('--dry-run')) {
    return '--plan and --dry-run are aliases; choose one';
  }
  for (const option of command.inputs.options.filter(option => option.required)) {
    if (!seenOptions.has(option.name)) return `${option.name} is required`;
  }
  const firstOption = args.findIndex(item => item.startsWith('-'));
  if (firstOption >= 0 && args.slice(firstOption).some(item => !item.startsWith('-'))) {
    return 'positional arguments must precede options';
  }
  const positionals = args.filter(item => !item.startsWith('-'));
  const required = command.inputs.positionals.filter(item => item.required).length;
  const variadic = command.inputs.positionals.find(item => item.variadic);
  const maximum = variadic?.maximumItems ?? command.inputs.positionals.length;
  if (positionals.length < required || positionals.length > maximum) {
    return `expected ${required === maximum ? required : `${required}-${maximum}`} positional arguments, got ${positionals.length}`;
  }
  for (const [index, contract] of command.inputs.positionals.entries()) {
    if (contract.enum && positionals[index] !== undefined && !contract.enum.includes(positionals[index])) {
      return `${contract.name} must be one of: ${contract.enum.join(', ')}`;
    }
  }
  const backend = args.find(item => item.startsWith('--backend='))?.slice('--backend='.length);
  if (backend && !command.backendSupport.includes(backend)) {
    return `backend ${backend} is not supported; choose ${command.backendSupport.join(' or ')}`;
  }
  return null;
}

function readManifest(path) {
  try {
    return JSON.parse(readFileSync(path, 'utf8'));
  } catch (error) {
    throw new Error(`cannot read manifest ${path}: ${error.message}`);
  }
}

function backendEnvironment(backend, manifestPath) {
  if (!backend || !manifestPath) return {};
  const manifest = readManifest(manifestPath);
  const generated = dirname(resolve(manifestPath));
  const environment = {
    ATTACKNET_BACKEND: backend,
    KUBE_NETWORK: String(manifest.network ?? ''),
    KUBE_NAMESPACE: String(manifest.namespace ?? ''),
  };
  if (backend === 'compose') {
    environment.ATTACKNET_PROJECT = environment.KUBE_NETWORK;
    environment.ATTACKNET_COMPOSE = join(generated, 'compose.yaml');
    environment.ATTACKNET_COMPOSE_EXTRA = join(generated, 'compose.observability.yaml');
    environment.ATTACKNET_COMPOSE_POLICY = join(generated, 'policy.env');
  }
  return environment;
}

function invocation(command, args, {resolveEnvironment = true} = {}) {
  const backendOption = args.find(item => item.startsWith('--backend='));
  const backend = backendOption?.slice('--backend='.length);
  const forwarded = args.filter(item => item !== backendOption && item !== '--plan' && item !== '--dry-run');
  const implementation = command.implementation;
  let executable;
  let executionArgs;
  let environment = {};
  let environmentSource = null;

  if (implementation.kind === 'lifecycle') {
    const generated = forwarded[0];
    const evidence = forwarded[1];
    const selectedBackend = backend ?? 'kubernetes';
    if (selectedBackend === 'compose') {
      executable = 'bash';
      executionArgs = [join(ATTACKNET_DIR, 'compose-lifecycle.sh'), implementation.action, generated];
      if (evidence) executionArgs.push(evidence);
    } else {
      executable = 'bash';
      executionArgs = [join(ATTACKNET_DIR, 'lifecycle.sh'), implementation.action];
      if (implementation.action === 'apply') executionArgs.push(generated);
      if (implementation.action === 'capture') executionArgs.push(evidence);
      const manifestPath = join(resolve(generated), 'manifest.json');
      environmentSource = {kind: 'rendered-manifest', path: manifestPath, resolved: resolveEnvironment};
      environment = resolveEnvironment
        ? backendEnvironment(selectedBackend, manifestPath)
        : {ATTACKNET_BACKEND: selectedBackend};
    }
  } else {
    executable = implementation.program === 'node' ? process.execPath : implementation.program;
    executionArgs = [join(ATTACKNET_DIR, implementation.path), ...(implementation.prefix ?? []), ...forwarded];
    if (backend) {
      let manifestPath;
      if (command.name === 'verify') manifestPath = forwarded[0];
      if (command.name === 'evidence capture') manifestPath = forwarded[1];
      environmentSource = {kind: 'manifest', path: resolve(manifestPath), resolved: resolveEnvironment};
      environment = resolveEnvironment ? backendEnvironment(backend, manifestPath) : {ATTACKNET_BACKEND: backend};
    }
  }
  return {executable, args: executionArgs, environment, environmentSource};
}

function execute(value, command, args) {
  if (args.includes('--plan') || args.includes('--dry-run')) {
    const resolved = invocation(command, args, {resolveEnvironment: false});
    process.stdout.write(`${JSON.stringify({
      schema: 'stacks-attacknet-command-plan/v1',
      interfaceVersion: value.interfaceVersion,
      command: command.name,
      sideEffectClass: command.sideEffectClass,
      requiredPrivileges: command.requiredPrivileges,
      backendSupport: command.backendSupport,
      invocation: resolved,
      executed: false,
    }, null, 2)}\n`);
    return;
  }
  const resolved = invocation(command, args);
  const child = spawnSync(resolved.executable, resolved.args, {
    env: {...process.env, ...resolved.environment},
    stdio: 'inherit',
  });
  if (child.error) {
    process.stderr.write(`attacknet: failed to start ${command.name}: ${child.error.message}\n`);
    process.exitCode = 1;
  } else if (child.signal) {
    process.stderr.write(`attacknet: ${command.name} terminated by ${child.signal}\n`);
    process.exitCode = 1;
  } else {
    process.exitCode = child.status ?? 1;
  }
}

let value;
try {
  value = registry();
  const argv = process.argv.slice(2);
  if (argv.length === 0 || (argv.length === 1 && ['--help', '-h'].includes(argv[0]))) {
    process.stdout.write(`${topHelp(value)}\n`);
  } else if (argv[0] === 'help') {
    const requested = argv.slice(1).join(' ');
    if (requested === '--help' || requested === '-h') {
      process.stdout.write(`${commandHelp(value.commands.find(item => item.name === 'help'), value)}\n`);
    } else if (!requested) process.stdout.write(`${topHelp(value)}\n`);
    else {
      const command = value.commands.find(item => item.name === requested);
      const help = command ? commandHelp(command, value) : groupHelp(value, requested);
      if (!help) die(`unknown command ${requested}`, topHelp(value));
      else process.stdout.write(`${help}\n`);
    }
  } else {
    const match = findCommand(value, argv);
    if (!match) {
      const requested = argv.filter(item => !item.startsWith('-')).slice(0, 2).join(' ');
      const help = groupHelp(value, requested) ?? groupHelp(value, argv[0]);
      if (help && (argv.length === 1 || argv[1] === '--help')) process.stdout.write(`${help}\n`);
      else die(`unknown command ${requested || argv[0]}`, topHelp(value));
    } else {
      const args = argv.slice(match.words.length);
      if (args.length === 1 && ['--help', '-h'].includes(args[0])) {
        process.stdout.write(`${commandHelp(match.command, value)}\n`);
      } else {
        const error = validateArguments(match.command, args);
        if (error) die(`${match.command.name}: ${error}`, usageFor(match.command));
        else if (match.command.implementation.kind === 'commands') {
          process.stdout.write(`${JSON.stringify(value, null, 2)}\n`);
        } else if (match.command.implementation.kind === 'help') {
          process.stdout.write(`${topHelp(value)}\n`);
        } else execute(value, match.command, args);
      }
    }
  }
} catch (error) {
  process.stderr.write(`attacknet: ${error?.message ?? error}\n`);
  process.exitCode = 1;
}
